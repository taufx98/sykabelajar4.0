{
  "name": "@sykabelajar/auth-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "check": "npm run typecheck && npm test && npm run build",
    "auth:schema:generate": "auth generate --config ./src/auth.cli.ts --output ./migrations/0001_better_auth.sql"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.15",
    "better-auth": "1.7.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "auth": "1.7.15",
    "typescript": "5.9.3",
    "wrangler": "4.156.2"
  }
}
