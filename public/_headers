# Cache policy for Cloudflare Pages static assets.
#
# Keep the app shell revalidated so deployments become visible immediately.
# "no-cache" allows conditional requests (typically a small 304 response);
# it does not force the browser to download the full HTML every time.
/*.html
  Cache-Control: no-cache, must-revalidate

# Vite emits content-hashed filenames under /assets/. A changed file gets a
# new URL, so it is safe to keep these files in the browser cache for 1 year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public files outside /assets/ (for example /SB_logo.png) intentionally use
# Cloudflare Pages' default revalidation policy until they have versioned names.
# Do not add a global /* rule: it would also match /assets/* and can conflict
# with the long-lived immutable policy above.
